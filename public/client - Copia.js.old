const $ = id => document.getElementById(id);
const canvas=$("board"), ctx=canvas.getContext("2d");
let ws=null, myId=null, players=[], state=null, selected=null, joined=false, obstacles=[];
const TILE=40, SIZE=20;
function connect(){
  const proto=location.protocol==="https:"?"wss:":"ws:";
  ws=new WebSocket(`${proto}//${location.host}`);
  ws.onopen=()=>{$("connection").textContent="Connesso";$("connection").style.color="#68d391"};
  ws.onclose=()=>{$("connection").textContent="Disconnesso";$("connection").style.color="#ff7272"};
  ws.onerror=()=>{$("connection").textContent="Errore connessione"};
  ws.onmessage=e=>{const m=JSON.parse(e.data);if(m.type==="joined"){myId=m.playerId;joined=true;$("lobbyStatus").textContent="Sei nella stanza. Aspetta gli altri piloti."}
    if(m.type==="state"){state=m.state;players=m.players||[];renderAll()}
    if(m.type==="error")$("lobbyStatus").textContent=m.message;
  };
}
function send(obj){if(ws&&ws.readyState===WebSocket.OPEN)ws.send(JSON.stringify(obj))}
$("join").onclick=()=>{if(joined)return;send({type:"join",name:$("name").value.trim()||"Pilota"});$("join").disabled=true};
$("start").onclick=()=>send({action:"start"});
$("endTurn").onclick=()=>send({action:"endTurn"});
function renderAll(){
  $("players").innerHTML=players.map((p,i)=>`<div class="playerRow"><span>${i===0?"★ ":""}${esc(p.name)}${p.id===myId?" (tu)":""}</span><span>${p.connected?"● online":"○ disconnesso"}</span></div>`).join("");
  $("start").disabled=!(players[0]?.id===myId&&players.length>=2&&!state?.started);
  $("join").disabled=joined||players.length>=3||!!state?.started;
  if(state?.started){$("lobby").classList.add("hidden");$("game").classList.remove("hidden");$("turnInfo").textContent=state.winner?`${players.find(p=>p.id===state.winner)?.name||"Un giocatore"} ha vinto!`:state.activePlayer===myId?`Round ${state.round} · È il tuo turno`:`Round ${state.round} · Turno di ${players.find(p=>p.id===state.activePlayer)?.name||"avversario"}`;$("endTurn").disabled=state.activePlayer!==myId||!!state.winner;draw();renderUnit();renderFleet();$("log").innerHTML=state.log.map(x=>`<div>${esc(x)}</div>`).join("");}
}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function draw(){
  ctx.clearRect(0,0,800,800);ctx.fillStyle="#0a121b";ctx.fillRect(0,0,800,800);
  for(let y=0;y<SIZE;y++)for(let x=0;x<SIZE;x++){
    ctx.fillStyle=((x+y)%2)?"#111e2a":"#142332";ctx.fillRect(x*TILE,y*TILE,TILE,TILE);
    ctx.strokeStyle="#253748";ctx.strokeRect(x*TILE,y*TILE,TILE,TILE);
    if((x*7+y*13)%37===0){ctx.fillStyle="#243b4b";ctx.fillRect(x*TILE+13,y*TILE+13,14,14)}
  }
  if(!state)return;
  const units=state.units;
  if(selected){const u=units.find(z=>z.id===selected);if(u&&u.owner===myId&&u.type!=="ship"&&!u.moved){ctx.fillStyle="#68b5ff22";for(let y=0;y<SIZE;y++)for(let x=0;x<SIZE;x++)if(Math.abs(u.x-x)+Math.abs(u.y-y)<=u.move&&!units.some(z=>z.hp>0&&z.x===x&&z.y===y)){ctx.fillRect(x*TILE,y*TILE,TILE,TILE)}}}
  for(const u of units){if(u.hp<=0)continue;const x=u.x*TILE,y=u.y*TILE, own=u.owner===myId;
    ctx.fillStyle=u.color;ctx.strokeStyle=own?"#bde3ff":"#ffd0d0";ctx.lineWidth=2;
    if(u.type==="ship"){ctx.beginPath();ctx.moveTo(x+20,y+4);ctx.lineTo(x+35,y+31);ctx.lineTo(x+20,y+26);ctx.lineTo(x+5,y+31);ctx.closePath();ctx.fill();ctx.stroke()}
    else if(u.type==="support"){ctx.fillRect(x+9,y+9,22,22);ctx.strokeRect(x+9,y+9,22,22);ctx.fillStyle="#e9f7ff";ctx.fillRect(x+18,y+12,4,16);ctx.fillRect(x+12,y+18,16,4)}
    else {ctx.fillRect(x+11,y+7,18,26);ctx.fillRect(x+6,y+12,7,15);ctx.fillRect(x+27,y+12,7,15);ctx.strokeRect(x+11,y+7,18,26)}
    if(u.id===selected){ctx.strokeStyle="#ffe082";ctx.lineWidth=3;ctx.strokeRect(x+2,y+2,36,36)}
    ctx.fillStyle="#05090e";ctx.fillRect(x+4,y+34,32,4);ctx.fillStyle="#65d995";ctx.fillRect(x+4,y+34,32*(u.hp/u.maxHp),4);
    ctx.fillStyle="#e8f0fa";ctx.font="10px system-ui";ctx.textAlign="center";ctx.fillText(u.type==="ship"?"CS":u.type==="support"?"SUP":String(u.id.match(/m(\d+)/)?.[1]||"M"),x+20,y+5);
    if(u.acted){ctx.fillStyle="#111827aa";ctx.fillRect(x+1,y+1,38,38)}
  }
}
function renderUnit(){
  const box=$("unitInfo"), actions=$("actions");actions.innerHTML="";
  const u=state?.units.find(z=>z.id===selected&&z.hp>0);
  if(!u){box.innerHTML='<span class="muted">Seleziona un’unità sulla mappa.</span>';return}
  box.innerHTML=`<strong>${esc(u.name)}</strong> · ${u.owner===myId?"Alleata":"Nemica"}<div class="stat"><div class="statTop"><span>HP</span><span>${u.hp}/${u.maxHp}</span></div><div class="bar hp"><i style="width:${100*u.hp/u.maxHp}%"></i></div></div><div class="stat"><div class="statTop"><span>Energia</span><span>${u.en}/${u.maxEn}</span></div><div class="bar en"><i style="width:${100*u.en/u.maxEn}%"></i></div></div><div class="stat"><div class="statTop"><span>Munizioni</span><span>${u.ammo}/${u.maxAmmo}</span></div><div class="bar"><i style="width:${100*u.ammo/u.maxAmmo}%"></i></div></div><div class="stat"><div class="statTop"><span>Volontà</span><span>${u.vt}/150</span></div><div class="bar vt"><i style="width:${100*u.vt/150}%"></i></div></div><small class="muted">${u.moved?"Movimento usato":"Movimento disponibile"} · ${u.acted?"Azione usata":"Azione disponibile"}</small>`;
  if(u.owner!==myId||state.activePlayer!==myId||state.winner)return;
  const add=(label,action,extra={})=>{const b=document.createElement("button");b.textContent=label;b.onclick=()=>send({action,unitId:u.id,...extra});actions.appendChild(b)};
  if(u.type!=="ship"&&!u.moved)add("Muovi: scegli casella","armMove");
  if(!u.acted){add("Attacca melee","armMelee");add("Fucile (2 ammo)","armGun");add("Laser (25 EN)","armLaser")}
  if((u.type==="support"||u.type==="ship")&&!u.acted){add("Rifornisci alleato","armResupply");add("Ripara alleato","armRepair")}
}
let mode=null;
const oldRenderUnit=renderUnit;
function armMode(m){mode=m;const names={armMove:"Clicca una casella valida per muovere.",armMelee:"Clicca un nemico adiacente.",armGun:"Clicca un nemico a distanza 2–5.",armLaser:"Clicca un nemico a distanza 2–5.",armResupply:"Clicca un alleato entro 2 caselle.",armRepair:"Clicca un alleato da riparare entro 2 caselle."};$("lobbyStatus").textContent=names[m]||"";}
const origRenderAll=renderAll;
const renderUnitBase=renderUnit;
renderUnit=function(){renderUnitBase();const buttons=$("actions").querySelectorAll("button");buttons.forEach(b=>{const label=b.textContent;if(label.startsWith("Muovi"))b.onclick=()=>armMode("armMove");else if(label.includes("melee"))b.onclick=()=>armMode("armMelee");else if(label.includes("Fucile"))b.onclick=()=>armMode("armGun");else if(label.includes("Laser"))b.onclick=()=>armMode("armLaser");else if(label.includes("Rifornisci"))b.onclick=()=>armMode("armResupply");else if(label.includes("Ripara"))b.onclick=()=>armMode("armRepair")})};
canvas.addEventListener("click",e=>{
  if(!state||!state.started||state.activePlayer!==myId||state.winner)return;
  const r=canvas.getBoundingClientRect(),x=Math.floor((e.clientX-r.left)/r.width*SIZE),y=Math.floor((e.clientY-r.top)/r.height*SIZE);
  const clicked=state.units.find(u=>u.hp>0&&u.x===x&&u.y===y);
  if(mode==="armMove"&&selected){send({action:"move",unitId:selected,x,y});mode=null;$("lobbyStatus").textContent="";return}
  if(mode&&selected&&clicked){
    const map={armMelee:"melee",armGun:"gun",armLaser:"laser"};
    if(map[mode])send({action:"attack",unitId:selected,targetId:clicked.id,weapon:map[mode]});
    else if(mode==="armResupply")send({action:"resupply",unitId:selected,targetId:clicked.id});
    else if(mode==="armRepair")send({action:"repair",unitId:selected,targetId:clicked.id});
    mode=null;$("lobbyStatus").textContent="";return;
  }
  if(clicked){selected=clicked.id;mode=null;draw();renderUnit()}
  else if(selected&&mode===null){selected=null;draw();renderUnit()}
});
connect();
